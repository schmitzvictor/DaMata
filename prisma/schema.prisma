// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  name        String
  description String?
  price       Float
  category    String
  featured    Boolean          @default(false)
  images      String[]
  weightGrams Int? // necessário para cálculo de frete (Melhor Envio)
  createdAt   DateTime         @default(now())
  variants    ProductVariant[]

  // ERP é a fonte da verdade para estoque/preço/nome/categoria. Nulo até o
  // primeiro sync (POST /api/sync/product). description/images/featured
  // continuam editáveis aqui (admin de conteúdo) e nunca são tocados pelo sync.
  erpProductId String? @unique
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  size      String
  color     String?
  stock     Int     @default(0)

  // Ver nota em Product.erpProductId — mesmo contrato, por variante.
  erpVariantId String? @unique
}

model Order {
  id                Int         @id @default(autoincrement())
  customerName      String
  customerEmail     String
  customerPhone     String?
  total             Float
  status            String      @default("pendente") // pendente | pago | enviado | entregue | cancelado
  addressZip        String
  addressStreet     String
  addressNumber     String
  addressComplement String?
  addressDistrict   String
  addressCity       String
  addressState      String
  addressReference  String?
  shippingMethod    String?
  shippingCost      Float?
  paymentProvider   String? // "mercadopago"
  paymentId         String? // id da preferência/pagamento no Mercado Pago
  paymentMethod     String? // pix | boleto | cartao
  paymentStatus     String      @default("pendente")
  createdAt         DateTime    @default(now())
  orderItems        OrderItem[]
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  productId   Int?
  productName String
  size        String
  quantity    Int
  price       Float

  // Snapshot do ProductVariant.erpVariantId no momento do pedido (mesmo
  // padrão de productName/price). É o que identifica o item pro ERP quando
  // o webhook de pagamento confirma a venda e registra a saída de estoque.
  // Nulo se o produto nunca foi sincronizado com o ERP.
  erpVariantId String?
}

model Post {
  id      Int      @id @default(autoincrement())
  title   String
  excerpt String
  content String
  image   String?
  author  String
  date    DateTime @default(now())
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String
  role          String    @default("user") // "admin" | "user"
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
}

model Setting {
  key   String @id
  value String // JSON stringificado
}
