# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (self-hosted na VM, mesmo container do ERP — dois bancos,
# um Postgres só). Ver README.md deste repo e o README.md do repo do ERP
# (seção "Deploy em produção") pra como criar a role/banco damata_site. ---
DATABASE_URL="postgresql://damata_site:damata_site@localhost:5432/damata_site"
# Usados pelo docker-compose.yml (serviço "app"/"migrate") pra montar a
# DATABASE_URL de produção, com host "db" em vez de "localhost".
POSTGRES_DB="damata_site"
POSTGRES_USER="damata_site"
POSTGRES_PASSWORD="damata_site"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=""
# Base URL of the app, used for callbacks. Set to your prod URL when deployed.
AUTH_URL="http://localhost:3000"
# Necessário em produção atrás de reverse proxy (Nginx) — sem isso o
# NextAuth rejeita o request com "UntrustedHost". Não precisa em dev.
AUTH_TRUST_HOST="true"

# --- Mercado Pago (checkout/pagamentos) ---
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# --- Melhor Envio (frete) ---
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
MELHOR_ENVIO_ACCESS_TOKEN=""

# --- Cloudflare R2 (armazenamento das imagens de produto) ---
# Bucket "damata-media", público. Token escopado só pra este bucket
# (Cloudflare Dashboard → R2 → Manage API Tokens) — não reusar o token do
# bucket damata-backups (usado pelo restic no ERP).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="damata-media"
# URL pública de leitura do bucket — domínio custom (ex. https://cdn.damata.app)
# ou o dev URL padrão do R2 (https://pub-<hash>.r2.dev), sem barra no final.
R2_PUBLIC_URL=""

# --- Resend (e-mails transacionais: pedido confirmado, redefinir senha, etc.) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Da Mata Grow <pedidos@damatagrow.com.br>"

# --- ERP externo (fonte da verdade de estoque/financeiro, app separado) ---
# Valida chamadas que CHEGAM do ERP em POST /api/sync/product (header
# "Authorization: Bearer <ERP_SYNC_SECRET>").
ERP_SYNC_SECRET=""
# Endereço base do ERP, para este site chamar (ex: notificar venda).
ERP_API_URL=""
# Autentica as chamadas que este site FAZ para o ERP (ex: POST /api/movements).
ERP_API_TOKEN=""
